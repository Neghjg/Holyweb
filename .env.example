# Optional. Without .env, docker compose starts in DEMO mode (DJANGO_DEBUG=1, SEED_DEMO=1, dev key).
# This file is a template for a prod-like run: cp .env.example .env, then set your own key.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=plan
POSTGRES_USER=plan
POSTGRES_PASSWORD=plan
CLICKHOUSE_USER=plan
CLICKHOUSE_PASSWORD=plan
CLICKHOUSE_DATABASE=plan
# ClickHouse client timeouts (seconds); their sum must stay below gunicorn --timeout (30)
CLICKHOUSE_CONNECT_TIMEOUT=5
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=10
# Demo users (rep/manager/nobody) with a KNOWN password. Demo only! 0 for a prod-like run.
SEED_DEMO=0
DEMO_PASSWORD=demo12345
# Host interface and port the backend is published on (loopback by default)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
