# Quick start (see README): (cat .env.example; echo "DJANGO_SECRET_KEY=$(openssl rand -hex 32)") > .env
# DJANGO_SECRET_KEY is REQUIRED and has no default (docker compose refuses to start without it).
# DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=plan
POSTGRES_USER=plan
POSTGRES_PASSWORD=plan
CLICKHOUSE_USER=plan
CLICKHOUSE_PASSWORD=plan
CLICKHOUSE_DATABASE=plan
# ClickHouse client timeouts (seconds); their sum must stay below gunicorn --timeout (30)
CLICKHOUSE_CONNECT_TIMEOUT=5
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=10
# Demo data (users rep/manager/nobody with a KNOWN password). Demo only! Compose default is 0.
SEED_DEMO=1
DEMO_PASSWORD=demo12345
# Host interface and port the backend is published on (loopback by default)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
