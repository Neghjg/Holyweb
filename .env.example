# Copy to .env (optional: docker-compose.yml has the same defaults).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=plan
POSTGRES_USER=plan
POSTGRES_PASSWORD=plan
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=plan
CLICKHOUSE_PASSWORD=plan
CLICKHOUSE_DATABASE=plan
# Demo data (users rep/manager/nobody with known passwords). Demo only!
SEED_DEMO=1
DEMO_PASSWORD=demo12345
# Host port for the backend container
BACKEND_PORT=8000
